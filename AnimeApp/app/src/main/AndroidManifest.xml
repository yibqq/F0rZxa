<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- One APK for phones, tablets and TV: neither touch nor the TV feature is required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!--
      No Android Auto / Automotive OS declarations: browsing anime is not an allowed car app
      category (see docs/PLATFORMS.md). The app must not be offered on car screens.
    -->

    <application
        android:name=".KuroApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Kuro">

        <!-- Phones, foldables, tablets, ChromeOS / desktop windows. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Kuro.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.details.DetailsActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <activity
            android:name=".ui.browse.BrowseActivity"
            android:exported="false"
            android:resizeableActivity="true" />

        <!-- Android TV / Google TV: separate D-pad experience. -->
        <activity
            android:name=".ui.tv.TvMainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kuro.Tv"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.tv.TvDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.Kuro.Tv" />

        <activity
            android:name=".ui.tv.TvBrowseActivity"
            android:exported="false"
            android:theme="@style/Theme.Kuro.Tv" />

        <!-- Persists the in-app language choice on Android 12 and below (AppCompat per-app locales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
