<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground for focusable cards: visible ring only when focused (D-pad / keyboard). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true"><shape><solid android:color="#00000000"/><corners android:radius="@dimen/radius_m"/><stroke android:width="3dp" android:color="@color/focus_ring"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#22FFFFFF"/><corners android:radius="@dimen/radius_m"/></shape></item>
    <item><shape><solid android:color="#00000000"/></shape></item>
</selector>
