<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/tvd_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_start" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/tvd_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="72dp"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter">

                <TextView
                    android:id="@+id/tvd_title"
                    style="@style/Kuro.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="760dp"
                    android:maxLines="2"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/tvd_meta"
                    style="@style/Kuro.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxWidth="760dp" />

                <TextView
                    android:id="@+id/tvd_synopsis"
                    style="@style/Kuro.Text.Body.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:maxWidth="720dp"
                    android:maxLines="4"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/tvd_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_light"
                    android:drawablePadding="6dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_history" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tvd_watch"
                        style="@style/Kuro.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="160dp"
                        android:text="@string/watch"
                        app:drawableStartCompat="@drawable/ic_play" />

                    <Button
                        android:id="@+id/tvd_status"
                        style="@style/Kuro.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:minWidth="160dp"
                        android:text="@string/add_to_list"
                        app:drawableStartCompat="@drawable/ic_plus" />

                    <Button
                        android:id="@+id/tvd_favorite"
                        style="@style/Kuro.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/favorite"
                        app:drawableStartCompat="@drawable/ic_heart" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/tvd_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="@color/text_secondary" />

                <app.kuro.anime.ui.common.StateView
                    android:id="@+id/tvd_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvd_episodes_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter">

                    <TextView
                        style="@style/Kuro.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/episodes_title" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <app.kuro.anime.ui.common.SegmentedControl
                            android:id="@+id/tvd_ranges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvd_ep_message"
                    style="@style/Kuro.Text.Body.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:visibility="gone" />

                <app.kuro.anime.ui.tv.FocusMemoryRecyclerView
                    android:id="@+id/tvd_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/gutter"
                    android:paddingBottom="14dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvd_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
