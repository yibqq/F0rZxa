<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="8dp">

    <app.kuro.anime.ui.common.AspectRatioImageView
        android:layout_width="@dimen/episode_thumb_width"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_skeleton"
        app:heightRatio="0.5625" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="60dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton_line" />
    </LinearLayout>
</LinearLayout>
