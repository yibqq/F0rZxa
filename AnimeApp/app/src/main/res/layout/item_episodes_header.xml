<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Kuro.SectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/episodes_title"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/ep_count"
            style="@style/Kuro.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/ep_ranges_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:scrollbars="none"
        android:visibility="gone">

        <app.kuro.anime.ui.common.SegmentedControl
            android:id="@+id/ep_ranges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/ep_message"
        style="@style/Kuro.Text.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textAlignment="viewStart"
        android:visibility="gone" />

    <Button
        android:id="@+id/ep_retry"
        style="@style/Kuro.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/retry"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_refresh" />

    <TextView
        android:id="@+id/ep_source"
        style="@style/Kuro.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textAlignment="viewStart"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />
</LinearLayout>
