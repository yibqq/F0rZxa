<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/gutter">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_field"
            android:drawablePadding="10dp"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="52dp"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textCursorDrawable="@drawable/cursor_white"
            android:textSize="16sp"
            app:drawableStartCompat="@drawable/ic_search"
            app:drawableTint="@color/text_tertiary" />

        <ImageButton
            android:id="@+id/search_clear"
            style="@style/Kuro.IconButton"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/clear_search"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:clipToPadding="false"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:scrollbars="none">

        <app.kuro.anime.ui.common.SegmentedControl
            android:id="@+id/search_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_l"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/history_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/space_s">

                <TextView
                    style="@style/Kuro.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/search_recent"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/history_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/search_clear_history"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_l" />
        </LinearLayout>

        <app.kuro.anime.ui.common.StateView
            android:id="@+id/search_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/search_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_m"
            android:background="@drawable/bg_popup"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
