<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform-specific window attributes live in values-v27 / v29 / v31. -->
    <style name="Theme.Kuro.Platform" parent="Theme.AppCompat.NoActionBar" />

    <style name="Theme.Kuro" parent="Theme.Kuro.Platform">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/active</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/active</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/active</item>
        <item name="colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorHighlight">#55FFFFFF</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/Kuro.Dialog</item>
        <item name="popupMenuStyle">@style/Kuro.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Kuro.PopupMenu</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Kuro.Tv" parent="Theme.Kuro">
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>

    <style name="Theme.Kuro.Splash" parent="Theme.Kuro" />

    <style name="Kuro.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/active</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Kuro.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Kuro.DialogButton.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Kuro.DialogButton.Muted</item>
    </style>

    <style name="Kuro.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kuro.DialogButton.Muted">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Kuro.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Typography -->
    <style name="Kuro.Text" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Kuro.Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Kuro.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Kuro.Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Kuro.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Kuro.Text.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Kuro.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Kuro.Text.Card">
        <item name="android:textSize">@dimen/text_card</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Controls -->
    <style name="Kuro.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Kuro.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_active</item>
        <item name="drawableTint">@color/on_active</item>
    </style>
    <style name="Kuro.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="drawableTint">@color/text_primary</item>
    </style>
    <style name="Kuro.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text_primary</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="Kuro.SectionHeader" parent="Kuro.Text.Headline" />
    <style name="Kuro.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="Kuro.Badge" parent="">
        <item name="android:background">@drawable/bg_pill_light</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
