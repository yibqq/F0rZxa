<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/d_name_layout"
        style="@style/Mizan.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/course_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/d_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/d_code_layout"
            style="@style/Mizan.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/course_code">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/d_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/d_credits_layout"
            style="@style/Mizan.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/credit_hours_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/d_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/d_final_layout"
        style="@style/Mizan.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/final_grade"
        app:helperText="@string/final_grade_helper">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/d_final"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/d_expected_layout"
        style="@style/Mizan.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/expected_grade"
        app:helperText="@string/expected_grade_helper">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/d_expected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/d_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/count_in_gpa"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        style="@style/Mizan.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/color"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/d_colors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        style="@style/Mizan.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/section_more_options"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/d_instructor_layout"
        style="@style/Mizan.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/instructor">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/d_instructor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/d_sessions_layout"
            style="@style/Mizan.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/total_lectures"
            app:helperText="@string/total_lectures_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/d_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/d_limit_layout"
            style="@style/Mizan.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/absence_limit_course"
            app:helperText="@string/absence_limit_course_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/d_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/d_total_marks_layout"
        style="@style/Mizan.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/course_total_marks"
        app:helperText="@string/course_total_marks_helper">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/d_total_marks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
</ScrollView>
