<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding pages: one ConstraintSet per page. The shown page is centred; earlier pages wait just past
  the start edge and later ones just past the end edge (mirrored automatically in RTL), so going forward
  slides the next page in from the reading direction. Swipe toward the start edge, or use the buttons.
-->
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        android:id="@+id/ob_t12"
        motion:constraintSetStart="@id/ob_state1"
        motion:constraintSetEnd="@id/ob_state2"
        motion:duration="450"
        motion:motionInterpolator="easeInOut">

        <OnSwipe
            motion:dragDirection="dragStart"
            motion:touchAnchorId="@id/ob_page1"
            motion:touchAnchorSide="start" />

        <KeyFrameSet>
            <!-- The incoming icon rises slightly while its page slides in. -->
            <KeyAttribute
                android:translationY="24dp"
                motion:framePosition="40"
                motion:motionTarget="@id/ob_page2" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="30"
                motion:motionTarget="@id/ob_page2" />
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="60"
                motion:motionTarget="@id/ob_page1" />
        </KeyFrameSet>
    </Transition>

    <Transition
        android:id="@+id/ob_t23"
        motion:constraintSetStart="@id/ob_state2"
        motion:constraintSetEnd="@id/ob_state3"
