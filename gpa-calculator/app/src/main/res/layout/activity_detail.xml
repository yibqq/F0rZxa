<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_grouped">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.gpacalculator.ui.widget.MaxWidthLinearLayout
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_margin"
                android:paddingEnd="@dimen/page_margin"
                app:contentMaxWidth="@dimen/content_max_width">

                <TextView
                    android:id="@+id/detail_large_title"
                    style="@style/Text.LargeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="22dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/Text.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/hero_caption"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/detail_gpa"
                        style="@style/Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/detail_out_of"
                        style="@style/Text.Subhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/label_secondary" />

                    <View
                        style="@style/Hairline"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detail_credits"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_credits" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detail_courses"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_courses" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detail_points"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_quality_points" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_cumulative_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.SectionHeader"
                        android:text="@string/section_cumulative" />

                    <com.gpacalculator.ui.widget.GroupCard
                        android:id="@+id/detail_cumulative_card"
                        style="@style/Card" />
                </LinearLayout>

                <TextView
                    style="@style/Text.SectionHeader"
                    android:text="@string/section_courses" />

                <com.gpacalculator.ui.widget.GroupCard
                    android:id="@+id/detail_courses_card"
                    style="@style/Card" />

                <TextView
                    android:id="@+id/detail_footer"
                    style="@style/Text.SectionFooter" />

                <com.gpacalculator.ui.widget.GroupCard
                    style="@style/Card"
                    android:layout_marginTop="@dimen/section_gap">

                    <TextView
                        android:id="@+id/detail_delete"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/row_height"
                        android:background="@drawable/bg_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/delete_record"
                        android:textColor="@color/destructive" />
                </com.gpacalculator.ui.widget.GroupCard>
            </com.gpacalculator.ui.widget.MaxWidthLinearLayout>
        </FrameLayout>
    </ScrollView>

    <include
        android:id="@+id/detail_top_bar"
        layout="@layout/nav_bar" />
</FrameLayout>
