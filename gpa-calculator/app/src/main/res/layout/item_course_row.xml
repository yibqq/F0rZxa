<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/course_row"
        style="@style/Row.Clickable"
        android:minHeight="60dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/course_name"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/course_detail"
                style="@style/Text.Footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/course_grade"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_grade_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/tint"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/course_chevron"
            android:layout_width="8dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron"
            android:tint="@color/label_tertiary" />
    </LinearLayout>

    <View
        android:id="@+id/row_separator"
        style="@style/Hairline.Inset"
        android:layout_gravity="top" />
</FrameLayout>
