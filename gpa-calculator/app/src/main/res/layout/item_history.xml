<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/page_margin"
    android:paddingBottom="5dp">

    <com.gpacalculator.ui.widget.GroupCard
        android:id="@+id/history_card"
        style="@style/Card">

        <LinearLayout
            android:id="@+id/history_row"
            style="@style/Row.Clickable"
            android:minHeight="76dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="68dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_gpa"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/history_scale"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_date"
                    style="@style/Text.Subhead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/history_summary"
                    style="@style/Text.Footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/history_cumulative"
                    style="@style/Text.Footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:textColor="@color/tint"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:layout_width="8dp"
                android:layout_height="14dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/label_tertiary" />
        </LinearLayout>
    </com.gpacalculator.ui.widget.GroupCard>
</FrameLayout>
