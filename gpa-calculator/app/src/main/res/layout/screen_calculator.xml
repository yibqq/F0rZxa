<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/calc_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.gpacalculator.ui.widget.MaxWidthLinearLayout
                android:id="@+id/calc_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_margin"
                android:paddingEnd="@dimen/page_margin"
                app:contentMaxWidth="@dimen/content_max_width">

                <TextView
                    android:id="@+id/calc_large_title"
                    style="@style/Text.LargeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/tab_calculator" />

                <com.gpacalculator.ui.widget.SegmentedControl
                    android:id="@+id/calc_scale"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp" />

                <!-- Result -->
                <LinearLayout
                    android:id="@+id/calc_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="22dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/Text.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/hero_caption"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/hero_value"
                        style="@style/Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/placeholder" />

                    <TextView
                        android:id="@+id/hero_out_of"
                        style="@style/Text.Subhead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/label_secondary" />

                    <View
                        style="@style/Hairline"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stat_credits"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_credits" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stat_courses"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_courses" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/stat_cumulative_group"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/stat_cumulative"
                                style="@style/Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tint" />

                            <TextView
                                style="@style/Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/stat_cumulative" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Courses -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:text="@string/section_courses" />

                <com.gpacalculator.ui.widget.GroupCard
                    style="@style/Card">

                    <LinearLayout
                        android:id="@+id/courses_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:id="@+id/courses_add_separator"
                        style="@style/Hairline.Inset"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/course_add"
                        style="@style/Row.Clickable">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            android:tint="@color/tint" />

                        <TextView
                            style="@style/Text.Body.Tint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/add_course" />
                    </LinearLayout>
                </com.gpacalculator.ui.widget.GroupCard>

                <TextView
                    android:id="@+id/courses_footer"
                    style="@style/Text.SectionFooter"
                    android:text="@string/courses_footer_empty" />

                <!-- Cumulative -->
                <TextView
                    style="@style/Text.SectionHeader"
                    android:text="@string/section_cumulative" />

                <com.gpacalculator.ui.widget.GroupCard
                    android:id="@+id/cumulative_card"
                    style="@style/Card"
                    android:animateLayoutChanges="true">

                    <LinearLayout
                        android:id="@+id/cumulative_toggle_row"
                        style="@style/Row.Clickable"
                        android:minHeight="52dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/include_previous" />

                        <com.gpacalculator.ui.widget.IosSwitch
                            android:id="@+id/cumulative_switch"
                            android:layout_width="51dp"
                            android:layout_height="31dp"
                            android:contentDescription="@string/include_previous" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cumulative_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/Hairline.Inset" />

                        <LinearLayout
                            style="@style/Row"
                            android:layout_height="@dimen/row_height">

                            <TextView
                                android:id="@+id/prev_gpa_label"
                                style="@style/Text.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:labelFor="@+id/prev_gpa"
                                android:text="@string/previous_gpa" />

                            <EditText
                                android:id="@+id/prev_gpa"
                                style="@style/InlineField"
                                android:hint="@string/hint_gpa"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:nextFocusDown="@+id/prev_credits" />
                        </LinearLayout>

                        <View style="@style/Hairline.Inset" />

                        <LinearLayout
                            style="@style/Row"
                            android:layout_height="@dimen/row_height">

                            <TextView
                                style="@style/Text.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:labelFor="@+id/prev_credits"
                                android:text="@string/completed_credits" />

                            <EditText
                                android:id="@+id/prev_credits"
                                style="@style/InlineField"
                                android:hint="@string/hint_credits"
                                android:imeOptions="actionDone"
                                android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>
                </com.gpacalculator.ui.widget.GroupCard>

                <TextView
                    android:id="@+id/cumulative_footer"
                    style="@style/Text.SectionFooter"
                    android:text="@string/cumulative_footer_off" />

                <TextView
                    android:id="@+id/calc_save"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="28dp"
                    android:enabled="false"
                    android:text="@string/save_to_history" />
            </com.gpacalculator.ui.widget.MaxWidthLinearLayout>
        </FrameLayout>
    </ScrollView>

    <include
        android:id="@+id/calc_top_bar"
        layout="@layout/nav_bar" />
</FrameLayout>
