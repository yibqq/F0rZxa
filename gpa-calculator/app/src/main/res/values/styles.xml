<?xml version="1.0" encoding="utf-8"?>
<!-- Typography modelled on the iOS Dynamic Type scale (sizes in sp follow the "Large" content size). -->
<resources>
    <style name="Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.LargeTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Text.NavTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.Body.Tint">
        <item name="android:textColor">@color/tint</item>
    </style>

    <style name="Text.Subhead">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Footnote">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/label_secondary</item>
    </style>

    <style name="Text.SectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Text.SectionFooter" parent="Text.Footnote">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Text.Hero">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">76sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.StatValue">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Button" parent="Text">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Button.Primary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- Plain text button used in navigation bars. -->
    <style name="Button.Bar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/bar_button_text</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/row_padding</item>
        <item name="android:paddingEnd">@dimen/row_padding</item>
    </style>

    <style name="Row.Clickable">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Hairline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/separator</item>
    </style>

    <style name="Hairline.Inset">
        <item name="android:layout_marginStart">@dimen/row_padding</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="InlineField" parent="Text.Body">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:textColor">@color/field_text</item>
        <item name="android:textColorHint">@color/label_tertiary</item>
        <item name="android:singleLine">true</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
